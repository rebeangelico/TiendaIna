@using System.Diagnostics.Metrics
@using TiendaIna.Core.Entities
@using TiendaIna.Core.Models
@using TiendaIna.Core.Services
@using TiendaIna.Infrastructure.Services
@using TiendaIna.Web.Blazor.Components.Component
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<RadzenLayout>
    <RadzenHeader>
        <RadzenRow class="header-row">
            <RadzenColumn Width="20%">
                <RadzenTextBox @bind-Value="searchText"
                               @onkeydown="OnKeyDown"
                               Placeholder="Buscar productos..."
                               Style="width:100%;" />
            </RadzenColumn>
            <RadzenColumn Width="60%" Style="text-align:center;">
                <a href="/" style="display:inline-block;">
                    <img src="lib/LOGO-NEGRO.png"
                         alt="Logo"
                         style="height:40px; cursor:pointer;" />
                </a>
            </RadzenColumn>
            <RadzenColumn Width="20%" Style="text-align:right; position:relative;">
                <CartComponent />
            </RadzenColumn>
        </RadzenRow>
    </RadzenHeader>
    <RadzenBody>
        @Body
    </RadzenBody>
</RadzenLayout>
<RadzenNotification />

@code {
    private string searchText = "";

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            NavigationManager.NavigateTo($"/catalogo?search={Uri.EscapeDataString(searchText)}");
    }
}

<style>
    .header-row {
        display: flex;
        align-items: center;
        padding: 0.5rem 1rem;
        background-color: #f5f5f5;
    }
</style>