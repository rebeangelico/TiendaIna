@using TiendaIna.Core.Models
@using TiendaIna.Core.Services

    <RadzenSidebar>
        <RadzenPanelMenu>
        @if (Categories != null) {
            @foreach (var cat in Categories) {
                    <RadzenPanelMenuItem Text="@cat.Name" Path="" />
                }
            }
        </RadzenPanelMenu>
    </RadzenSidebar>

@code {

    [Parameter] public List<CategoryModel>? Categories { get; set; }

}