@page "/"
@page "/products"
@layout StoreLayout
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@using TiendaIna.Web.Blazor.Components.Component
@using TiendaIna.Web.Blazor.Components.Layout
@using Radzen
@using Radzen.Blazor
@using TiendaIna.Core.Models
@using TiendaIna.Core.Services
@using TiendaIna.Core

<PageTitle>Products</PageTitle>

<div class="page-container">
    <!-- Botón hamburguesa fuera de la sidebar -->
    <div class="hamburger-button">
        <RadzenButton Icon="menu"
                      ButtonStyle="ButtonStyle.Light"
                      Click="@ToggleSidebar"
                      Style="width: 40px; height: 40px;" />
    </div>

    <!-- Sidebar -->
    <div class="sidebar @(isSidebarOpen ? "sidebar-open" : "sidebar-closed")">
        <div class="sidebar-content">
            <CategoriesSidebar Categories="@Categories" />
        </div>
    </div>

    <div class="main-content">
        <RadzenRow>
            @if (PagedProducts != null) {
                @foreach (var product in PagedProducts) {
                    <RadzenColumn SizeXL="3" SizeLG="4" SizeMD="6" SizeSM="6">
                        <RadzenCard Style="margin:10px; text-align:center; height: 100%">
                            <RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Center" Gap="0px" Style="height:100%;">
                                <RadzenRow AlignItems="AlignItems.Center">
                                    @{
                                        var img = product?.Images?.Values?.FirstOrDefault()?.SmallUrl ?? "placeholder.png";
                                    }
                                    <img src="@img"
                                         alt="@product?.Name"
                                         style="width:100%; height:200px; object-fit:cover;" />
                                </RadzenRow>
                                <RadzenRow AlignItems="AlignItems.Center" style="padding-top: 15px">
                                    <h3 style="font-size:25px; margin:0;">@product.Name</h3>
                                </RadzenRow>

                                <RadzenRow AlignItems="AlignItems.Center" Style="padding-bottom: 15px;">
                                    <p>
                                        <strong>Marca:</strong>
                                        <RadzenButton Text="@product.Brand?.Name"
                                                      Size="ButtonSize.Small"
                                                      ButtonStyle="ButtonStyle.Light"
                                                      Style="margin:3px; border-radius:6px; font-size:12px;"
                                                      Click="@(() => FilterByBrand(product.BrandId))" />
                                    </p>
                                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Shade="Shade.Light" Variant="Variant.Outlined">
                                        <span style="font-size: 1rem; padding: 5px;">$@product.Price</span>
                                    </RadzenBadge>
                                </RadzenRow>

                                <RadzenRow AlignItems="AlignItems.Center">
                                    <RadzenColumn>
                                        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceAround">
                                            @if (product.Categories != null && product.Categories.Any()) {
                                                @foreach (var cat in product.Categories) {
                                                    <RadzenButton Text="@cat.Name"
                                                                  Size="ButtonSize.Small"
                                                                  ButtonStyle="ButtonStyle.Light"
                                                                  Style="border-radius:6px; font-size:12px;"
                                                                  Click="@(() => FilterByCategory(cat.Id))" />
                                                }
                                            }
                                        </RadzenRow>
                                    </RadzenColumn>
                                </RadzenRow>
                                <RadzenRow AlignItems="AlignItems.Center" Style="flex:1;">
                                    <p>@product.DescriptionShort</p>
                                </RadzenRow>
                                <RadzenRow AlignItems="AlignItems.Center">
                                    <RadzenColumn>
                                        <RadzenButton Text="Ver producto" Icon="visibility" ButtonStyle="ButtonStyle.Light" Style="min-width: 150px; margin:5px;" Click="@(() => NavigationManager.NavigateTo($"/productDetails/{product.Id}"))" />
                                        <RadzenButton Text="Añadir al carrito" Icon="add_shopping_cart" ButtonStyle="ButtonStyle.Success" Style="min-width: 150px; margin:5px;" Click="() => AddToCart(product.Id, 1)" />
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenStack>
                        </RadzenCard>
                    </RadzenColumn>
                }
            }
        </RadzenRow>

        <!-- Paginación -->
        <div style="text-align:center; margin-top:20px; padding-bottom:20px;">
            <RadzenPager Count="@Products.Count"
                         PageSize="@_pageSize"
                         PageChanged="OnPageChanged" />
        </div>
    </div>
</div>

@code {
    private bool isSidebarOpen = false;

    private void ToggleSidebar() {
        isSidebarOpen = !isSidebarOpen;
    }
}

<style>
    .hamburger-button {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 1002;
        background-color: #f5f5f5;
        width: 100%;
        padding: 10px;
        box-sizing: border-box;
    }

        .hamburger-button button {
            margin: 0 !important;
        }

    .page-container {
        display: flex;
        min-height: 100vh;
        width: 100%;
        position: relative;
    }

    .sidebar {
        width: 250px;
        min-height: 100vh;
        background-color: #f5f5f5;
        padding: 0;
        box-sizing: border-box;
        flex-shrink: 0;
        transition: transform 0.3s ease;
    }

    .sidebar-header {
        display: none;
        height: 60px;
        background-color: #f5f5f5;
    }

    .main-content {
        flex: 1;
        padding: 10px;
        overflow-x: hidden;
    }

    .sidebar-overlay {
        display: none;
    }


    @@media (max-width: 768px) {
        .hamburger-button

    {
        display: block;
    }

    .sidebar-header {
        display: block;
    }

    /* Sidebar oculta por defecto en mobile */
    .sidebar {
        position: fixed;
        left: 0;
        top: 0;
        transform: translateX(-100%);
        z-index: 1001;
        box-shadow: 2px 0 5px rgba(0,0,0,0.1);
    }

        /* Ocultar completamente cuando está cerrada */
        .sidebar.sidebar-closed {
            transform: translateX(-100%);
            visibility: hidden;
        }

        /* Sidebar abierta */
        .sidebar.sidebar-open {
            transform: translateX(0);
            visibility: visible;
        }

        /* Ocultar el contenido de Radzen cuando está cerrada */
        .sidebar.sidebar-closed .rz-sidebar,
        .sidebar.sidebar-closed .rz-panel-menu {
            display: none;
        }

    /* Overlay oscuro cuando sidebar está abierta */
    .sidebar-overlay {
        display: block;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 999;
    }

    /* Ajustar contenido principal en mobile */
    .main-content {
        width: 100%;
        padding-top: 10px;
    }

    }

    /* En pantallas grandes, añadir padding a la sidebar */
    @@media (min-width: 769px) {
        .sidebar

    {
        padding: 10px;
        transform: translateX(0) !important;
    }

    }
</style>