@page "/"
@page "/products"
@layout StoreLayout
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@using TiendaIna.Web.Blazor.Components.Component
@using TiendaIna.Web.Blazor.Components.Layout
@using Radzen
@using Radzen.Blazor
@using TiendaIna.Core.Models
@using TiendaIna.Core.Services
@using TiendaIna.Core

<PageTitle>Products</PageTitle>

<div class="barra-horizontal">
    <div class="barra-contenido">
        <div class="barra-izquierda">
            <RadzenButton Icon="menu"
                          ButtonStyle="ButtonStyle.Light"
                          Click="@ToggleSidebar"
                          Style="width: 40px; height: 40px;" />
        </div>

        <div class="barra-centro">
            <div class="filtros-aplicados">
                @foreach (var filtro in FiltersApplied) {
                    <div class="filtro-badge">
                        <RadzenBadge Text="@filtro.FilterText"
                                     IsPill="true"
                                     Style="padding-right: 25px;" />

                        <RadzenIcon Icon="close"
                                    Style="position: absolute; right: 5px; top: 50%; transform: translateY(-50%); cursor: pointer;"
                                    @onclick="@(() => RemoveFilter(filtro))" />
                    </div>
                }
            </div>

        </div>
    </div>
</div>

<div class="page-container">
    <div class="sidebar @(isSidebarOpen ? "sidebar-open" : "sidebar-closed")">
        <div class="sidebar-content">
            <CategoriesSidebar Categories="@Categories"
                               OnCategoryClick="@FilterByCategory" />

        </div>
    </div>

    <div class="main-content">
        <RadzenRow>
            @if (PagedProducts != null) {
                @foreach (var product in PagedProducts) {
                    <RadzenColumn SizeXL="3" SizeLG="4" SizeMD="6" SizeSM="6">
                        <RadzenCard Style="margin:10px; text-align:center; height: 100%">
                            <RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Center" Gap="0px" Style="height:100%;">
                                <RadzenRow AlignItems="AlignItems.Center">
                                    @{
                                        var img = product?.Images?.Values?.FirstOrDefault()?.SmallUrl ?? "placeholder.png";
                                    }
                                    <img src="@img"
                                         alt="@product?.Name"
                                         style="width:100%; height:200px; object-fit:cover;" />
                                </RadzenRow>

                                <RadzenRow AlignItems="AlignItems.Center"
                                           Style="padding:5px 0; display:flex; justify-content:space-between;">
                                    <div style="display:flex; align-items:center; gap:6px;">
                                        <strong>Marca:</strong>
                                        <RadzenButton Text="@product.Brand?.Name"
                                                      Size="ButtonSize.Small"
                                                      ButtonStyle="ButtonStyle.Light"
                                                      Style="margin:0; border-radius:6px; font-size:12px; padding:2px 10px;"
                                                      Click="@(() => FilterByBrand(product.BrandId))" />
                                    </div>
                                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Shade="Shade.Light" Variant="Variant.Outlined">
                                        <span style="font-size:0.95rem; padding:2px 6px; font-weight:600;">$@product.Price</span>
                                    </RadzenBadge>
                                </RadzenRow>

                                <RadzenRow AlignItems="AlignItems.Center" Style="margin:4px 0;">
                                    <RadzenColumn>
                                        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Start" Style="gap:4px; flex-wrap:wrap;">
                                            <strong>Categorias:</strong>
                                            @foreach (var cat in product.Categories)
                                            {
                                                <RadzenButton Text="@cat.Name"
                                                              Size="ButtonSize.Small"
                                                              ButtonStyle="ButtonStyle.Light"
                                                              Style="border-radius:4px; font-size:11px; padding:2px 8px; margin:0;"
                                                              Click="@(() => FilterByCategory(cat.Id))" />
                                            }
                                        </RadzenRow>
                                    </RadzenColumn>
                                </RadzenRow>

                                <RadzenRow AlignItems="AlignItems.Center" Style="flex:1; margin:4px 0;">
                                    <p style="margin:0; font-size:13px;">@product.DescriptionShort</p>
                                </RadzenRow>

                                <RadzenRow AlignItems="AlignItems.Center" Style="margin-top:10px;">
                                    <RadzenColumn>
                                        <RadzenButton Text="Ver producto" Icon="visibility" ButtonStyle="ButtonStyle.Light"
                                                      Style="min-width:140px; margin:4px;" Click="@(() => NavigationManager.NavigateTo($"/productDetails/{product.Id}"))" />
                                        <RadzenButton Text="Añadir al carrito" Icon="add_shopping_cart" ButtonStyle="ButtonStyle.Success"
                                                      Style="min-width:140px; margin:4px;" Click="() => AddToCart(product.Id, 1)" />
                                    </RadzenColumn>
                                </RadzenRow>

                            </RadzenStack>
                        </RadzenCard>
                    </RadzenColumn>
                }
            }
        </RadzenRow>

        <!-- Paginación -->
        <div style="text-align:center; margin-top:20px; padding-bottom:20px;">
            <RadzenPager Count="@Products.Count"
                         PageSize="@_pageSize"
                         PageChanged="OnPageChanged" />
        </div>
    </div>
</div>



<style>
    .hamburger-button {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 1002;
        background-color: #f5f5f5;
        width: 100%;
        padding: 10px;
        box-sizing: border-box;
    }

        .hamburger-button button {
            margin: 0 !important;
        }

    .page-container {
        display: flex;
        min-height: 100vh;
        width: 100%;
        position: relative;
    }

    .sidebar {
        width: 250px;
        min-height: 100vh;
        background-color: #f5f5f5;
        padding: 0;
        box-sizing: border-box;
        flex-shrink: 0;
        transition: transform 0.3s ease;
    }

    .sidebar-header {
        display: none;
        height: 60px;
        background-color: #f5f5f5;
    }

    .main-content {
        flex: 1;
        padding: 10px;
        overflow-x: hidden;
    }

    .sidebar-overlay {
        display: none;
    }


    @@media (max-width: 768px) {
        .hamburger-button

    {
        display: block;
    }

    .sidebar-header {
        display: block;
    }

    .sidebar {
        position: fixed;
        left: 0;
        top: 60px; /* ?? Ajustado para que no tape la barra horizontal */
        transform: translateX(-100%);
        z-index: 1001;
        box-shadow: 2px 0 5px rgba(0,0,0,0.1);
        height: calc(100vh - 60px); /* ?? Ajusta la altura para que no se desborde */
    }

        .sidebar.sidebar-closed {
            transform: translateX(-100%);
            visibility: hidden;
        }

        .sidebar.sidebar-open {
            transform: translateX(0);
            visibility: visible;
        }

        .sidebar.sidebar-closed .rz-sidebar,
        .sidebar.sidebar-closed .rz-panel-menu {
            display: none;
        }

    .sidebar-overlay {
        display: block;
        position: fixed;
        top: 60px; /* ?? También ajustamos el overlay */
        left: 0;
        width: 100%;
        height: calc(100vh - 60px);
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 999;
    }

    .main-content {
        width: 100%;
        padding-top: 10px;
    }

    }

    /* En pantallas grandes, añadir padding a la sidebar */
    @@media (min-width: 769px) {
        .sidebar {
            padding: 10px;
            transform: translateX(0) !important;
        }
    }

    .barra-horizontal {
        width: 100%;
        border-bottom: 1px solid #ccc;
        padding: 7px 14px;
        box-sizing: border-box;
    }

    .barra-contenido {
        display: flex;
        align-items: center;
        position: relative;
    }

    .barra-izquierda {
        z-index: 1;
    }

    .barra-centro {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        font-weight: bold;
        font-size: 1.2rem;
    }

    .filtros-aplicados {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 5px;
    }

    .filtro-badge {
        position: relative;
        display: inline-block;
    }


</style>

