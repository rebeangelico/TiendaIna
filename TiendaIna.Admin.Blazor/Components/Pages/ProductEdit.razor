@page "/products/edit/{productId:int}"
@using TiendaIna.Admin.Blazor.Components.Pages.Shared.Components
@using TiendaIna.Core.Models
@using TiendaIna.Core.Services
@rendermode InteractiveServer

@inject IProductsService ProductsService

<h2>Editar producto</h2>


<div class="container-fluid">
@if (Product != null) {
    <!-- Fila superior dividida en 2 columnas -->
        <div class="row">
            <!-- Columna izquierda mia-->
        <div class="col-md-7 col-12">
            <div class="row">
                    <div class="col-md-6 col-12 mb-3 border rounded shadow-sm">
                        <h4 class="mb-1" style="font-size: 1.1rem;">Nombre</h4>
                        <RadzenTextArea @bind-Value="Product.Name"
                                        Placeholder="Escribí el nombre del producto"
                                        Style="width: 100%; font-size: 1.1rem; height: 40px;" />
                    </div>

                    <div class="col-md-6 col-12 mb-3 border rounded shadow-sm">
                        <h4 class="mb-1" style="font-size: 1.1rem;">Genero</h4>
                        <RadzenTextArea @bind-Value="Product.Gender"
                                        Placeholder="genero"
                                        Style="width: 100%; font-size: 1.1rem; height: 40px;" />
                    </div>
            </div>
             <div class="row">
                    <div class="col-md-6 col-12 mb-3 border rounded shadow-sm">
                        <h4 class="mb-1" style="font-size: 1.1rem;">Marca</h4>
                        <RadzenTextArea @bind-Value="Product.Brand.Name"
                                        Placeholder="Escribí  del producto"
                                        Style="width: 100%; font-size: 1.1rem; height: 40px;" />
                    </div>

                    <div class="col-md-6 col-12 mb-3 border rounded shadow-sm">
                        <h4 class="mb-1" style="font-size: 1.1rem;">Genero</h4>
                        <RadzenTextArea @bind-Value="Product.Gender"
                                        Placeholder="genero"
                                        Style="width: 100%; font-size: 1.1rem; height: 40px;" />
                    </div>
             </div>




        </div>
        <div class="col-md-5 col-12">
                <!-- Columna derecha mia -->
                <EditImages Product="Product" />

                <RadzenNumeric TValue="decimal?" @bind-Value="Product.Price" Format="$0.00" Min="0m" />

                <EditFields Product="Product"
                            ShowDescription="true" ShowCategories="true" />
        </div>
    </div>

    <!-- Fila inferior con márgenes -->
        <div class="row mt-4 mb-5">
        <div class="col-12">

                <RadzenNumeric TValue="decimal?" @bind-Value="Product.Price" Format="$0.00" Min="0m" />

        </div>
    </div>

    } else {
<p>Cargando producto...</p>
    }
</div>