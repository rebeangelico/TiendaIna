@page "/orders"
@rendermode InteractiveServer
@using Radzen
@using Radzen.Blazor
@using TiendaIna.Admin.Blazor.Components.Pages.Shared.Components
@using TiendaIna.Core.Models
@using TiendaIna.Core.Services
@using TiendaIna.Core
@inject NavigationManager NavigationManager


<div class="page-container">
    <div class="component-wrapper component-top">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h3 class="card-title mb-0">Gestión de Pedidos</h3>

                            <!-- Crear nuevo pedido, la logica momentaneamente no lo necesita manual

                            <RadzenButton ButtonStyle="ButtonStyle.Success"
                                          Icon="add_circle_outline"
                                          class="me-2"
                                          Text="Nuevo Pedido"
                                          Click="@(() => NavigationManager.NavigateTo("/order/edit/0"))" />-->
                        </div>

                        <div class="card-body">
                            <RadzenDataGrid @ref="Grid"
                                            Data="@Orders"
                                            TItem="OrderModel"
                                            AllowPaging="true"
                                            PageSize="10"
                                            AllowSorting="true"
                                            AllowFiltering="false"
                                            RowHover="true"
                                            Responsive="true"
                                            EmptyText="No hay pedidos disponibles.">
                                <Columns>
                                    <RadzenDataGridColumn TItem="OrderModel" Property="Id" Title="N° Pedido" />
                                    <RadzenDataGridColumn TItem="OrderModel" Property="Client.Name" Title="Cliente" />
                                    <RadzenDataGridColumn TItem="OrderModel" Property="DateTime" Title="Fecha y Hora" />
                                    <RadzenDataGridColumn TItem="OrderModel" Property="Status" Title="Estado pedido" />
                                    <RadzenDataGridColumn TItem="OrderModel" Property="Amount" Title="Precio total" />
                                    <RadzenDataGridColumn TItem="OrderModel" Property="LastPayment.Status" Title="Ultimo Pago" />

                                    <RadzenDataGridColumn TItem="OrderModel" Title="Acciones" TextAlign="TextAlign.Right">
                                        <Template Context="o">
                                            <RadzenButton Icon="edit"
                                                          ButtonStyle="ButtonStyle.Light"
                                                          Size="ButtonSize.Medium"
                                                          Click="@(() => NavigationManager.NavigateTo($"/order/edit/{o.Id}"))"
                                                          @onclick:stopPropagation="true" />
                                            <RadzenButton Icon="delete"
                                                          ButtonStyle="ButtonStyle.Danger"
                                                          Shade="Shade.Lighter"
                                                          Size="ButtonSize.Medium"
                                                          class="ms-2"
                                                          Click="@(() => Delete(o.Id))"
                                                          @onclick:stopPropagation="true" />
                                        </Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                        </div> 
                    </div> 
                </div>
            </div>
        </div>
    </div>
</div>


<style>
    .page-container {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        width: 100%;
        margin: 0;
        padding: 0;
    }

    .component-wrapper {
        width: 100%;
        display: flex;
        flex-direction: column;
    }

    .component-top {
        flex: 1;
        min-height: 50vh;
        background-color: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
    }

    .component-bottom {
        flex: 1;
        min-height: 50vh;
        background-color: #ffffff;
    }

    @@media (max-width: 768px) {
        .component-top,
        .component-bottom {
            min-height: 40vh;
            padding: 1rem;
        }
    }

    @@media (max-width: 480px) {
        .component-top,
        .component-bottom {
            min-height: 35vh;
            padding: 0.5rem;
        }
    }

    @@media (min-width: 1200px) {
        .component-top,
        .component-bottom {
            min-height: 45vh;
        }
    }

    .component-wrapper ::deep > * {
        width: 100%;
        height: 100%;
    }

    ::deep body {
        margin: 0;
        padding: 0;
    }
</style>