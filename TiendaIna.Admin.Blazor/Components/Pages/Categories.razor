@page "/categories"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using TiendaIna.Core.Entities
@using TiendaIna.Core.Models
@using TiendaIna.Core.Services
@using Microsoft.AspNetCore.Components.Forms
@using System.Collections.Generic
@using System.Threading.Tasks
@using Radzen
@using Radzen.Blazor


<div class="page-container">
    <div class="component-wrapper component-top">

        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h3 class="card-title mb-0">Gestión de Categorías</h3>
                            <RadzenButton ButtonStyle="ButtonStyle.Success"
                                          Icon="add_circle_outline"
                                          class="me-2"
                                          Text="Nueva Categoría"
                                          Click="@InsertRow"
                                          Disabled="@(categoryToInsert != null || categoryToUpdate != null)" />
                        </div>
                        <div class="card-body">
                            @if (isLoading) {
                                <div class="text-center p-4">
                                    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                                    <p class="mt-2">Cargando categorías...</p>
                                </div>
                            } else {
                                <RadzenDataGrid @ref="grid"
                                                Data="@categories"
                                                TItem="CategoryModel"
                                                AllowFiltering="true"
                                                AllowColumnResize="true"
                                                AllowAlternatingRows="false"
                                                FilterMode="FilterMode.Advanced"
                                                AllowSorting="true"
                                                PageSize="20"
                                                AllowPaging="true"
                                                PagerHorizontalAlign="HorizontalAlign.Left"
                                                ShowPagingSummary="true"
                                                Sort="@Reset"
                                                Page="@Reset"
                                                Filter="@Reset"
                                                ColumnWidth="300px"
                                                EditMode="DataGridEditMode.Single">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="CategoryModel" Property="Id" Title="ID" Width="80px" />

                                        <RadzenDataGridColumn TItem="CategoryModel" Property="Name" Title="Nombre">
                                            <Template Context="category">
                                                @category.Name
                                            </Template>
                                            <EditTemplate Context="category">
                                                <RadzenTextBox @bind-Value="category.Name" Style="width:100%; display: block" Name="Name" />
                                                <RadzenRequiredValidator Text="El nombre es requerido" Component="Name" Popup="true" />
                                            </EditTemplate>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn TItem="CategoryModel" Property="ParentId" Title="Categoría Padre">
                                            <Template Context="category">
                                                @GetParentCategoryName(category.ParentCategoryId)
                                            </Template>
                                            <EditTemplate Context="category">
                                                <RadzenDropDown @bind-Value="category.ParentCategoryId"
                                                                Data="@parentCategories"
                                                                TextProperty="Name"
                                                                ValueProperty="Id"
                                                                Placeholder="Seleccionar categoría padre (opcional)"
                                                                AllowClear="true"
                                                                Style="width:100%; display: block" />
                                            </EditTemplate>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn TItem="CategoryModel" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Width="156px">
                                            <Template Context="category">
                                                <RadzenButton Icon="edit"
                                                              ButtonStyle="ButtonStyle.Light"
                                                              Size="ButtonSize.Medium"
                                                              Click="@(args => EditRow(category))"
                                                              @onclick:stopPropagation="true">
                                                </RadzenButton>
                                                <RadzenButton ButtonStyle="ButtonStyle.Danger"
                                                              Icon="delete"
                                                              Shade="Shade.Lighter"
                                                              Size="ButtonSize.Medium"
                                                              class="my-1 ms-1"
                                                              Click="@(args => DeleteRow(category))"
                                                              @onclick:stopPropagation="true">
                                                </RadzenButton>
                                            </Template>
                                            <EditTemplate Context="category">
                                                <RadzenButton Icon="check"
                                                              ButtonStyle="ButtonStyle.Success"
                                                              Size="ButtonSize.Medium"
                                                              Click="@((args) => SaveRow(category))">
                                                </RadzenButton>
                                                <RadzenButton Icon="close"
                                                              ButtonStyle="ButtonStyle.Light"
                                                              Size="ButtonSize.Medium"
                                                              class="my-1 ms-1"
                                                              Click="@((args) => CancelEdit(category))">
                                                </RadzenButton>
                                                <RadzenButton ButtonStyle="ButtonStyle.Danger"
                                                              Icon="delete"
                                                              Shade="Shade.Lighter"
                                                              Size="ButtonSize.Medium"
                                                              class="my-1 ms-1"
                                                              Click="@(args => DeleteRow(category))">
                                                </RadzenButton>
                                            </EditTemplate>
                                        </RadzenDataGridColumn>
                                    </Columns>
                                </RadzenDataGrid>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="component-wrapper component-bottom">

    </div>
</div>














<style>
    .page-container {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        width: 100%;
        margin: 0;
        padding: 0;
    }

    .component-wrapper {
        width: 100%;
        display: flex;
        flex-direction: column;
    }

    .component-top {
        flex: 1;
        min-height: 50vh;
        background-color: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
    }

    .component-bottom {
        flex: 1;
        min-height: 50vh;
        background-color: #ffffff;
    }

    @@media (max-width: 768px) {
        .component-top,
        .component-bottom {
            min-height: 40vh;
            padding: 1rem;
        }
    }

    @@media (max-width: 480px) {
        .component-top,
        .component-bottom {
            min-height: 35vh;
            padding: 0.5rem;
        }
    }

    @@media (min-width: 1200px) {
        .component-top,
        .component-bottom {
            min-height: 45vh;
        }
    }

    .component-wrapper ::deep > * {
        width: 100%;
        height: 100%;
    }

    ::deep body {
        margin: 0;
        padding: 0;
    }
</style>

