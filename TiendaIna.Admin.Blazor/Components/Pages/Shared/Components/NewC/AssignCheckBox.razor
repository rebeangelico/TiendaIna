@rendermode InteractiveServer
@namespace TiendaIna.Admin.Blazor.Components.Pages.Shared.Components

<div class="container-fluid">
    <div class="row">
        @if (Data is not null) {
            foreach (var d in Data) {
                <RadzenLabel Text="@d.Value" class="rz-ms-4" />
                <RadzenCheckBox TValue="bool" Value="@IsSelected(d.Key)" Change="(val) => OnChange(d.Key, val)" />
            }
        }
    </div>
</div>
