@typeparam TValue
@using Radzen.Blazor

<RadzenNumeric TValue="TValue"
               @bind-Value="@Value"
               Placeholder="@Placeholder"
               Disabled="@Disabled"
               Style="width: 100%;"
               class="@CssClass"
               Step="@GetStepValue()"
               Min="@GetMinValue()"
               Max="@GetMaxValue()"
               ShowUpDown="@ShowUpDown"
               Format="@GetFormatString()" />