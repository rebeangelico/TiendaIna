@typeparam TValue
@using Radzen.Blazor

<RadzenNumeric TValue="TValue"
               @bind-Value="@Value"
               Disabled="@Disabled"
               Min="@Min"
               Max="@Max"
               Step="@Step"
               Placeholder="@Placeholder"
