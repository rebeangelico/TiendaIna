@page "/edit-fields"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using TiendaIna.Core.Entities
@using TiendaIna.Core.Models
@using TiendaIna.Core.Services


<div class="container mt-4">
    <div class="col-md-6">
        @if (ShowName == true) {
            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <input class="form-control" @bind="Product.Name" />
            </div>
        }

        @if (ShowPrice == true) {
            <div class="mb-3">
                <label class="form-label">Precio</label>
                <input class="form-control" @bind="Product.Price" />
            </div>
        }

        @if (ShowDescriptionMin == true) {
            <div class="mb-3">
                <label class="form-label">Descripción corta</label>
                <input class="form-control" @bind="Product.DescriptionMin" />
            </div>
        }

        @if (ShowBrand == true) {
            <div class="mb-3">
                <label class="form-label">Marca</label>
                <input class="form-control" @bind="Product.Brand.Name" />
            </div>
        }


        @if (ShowGender == true) {
            <div class="mb-3">
                <label class="form-label">Genero</label>
                <input class="form-control" @bind="Product.Gender" />
            </div>
        }

        @if (ShowIsOutstanding == true) {
            <div class="mb-3">
                <label class="form-label">Destacado</label>
                <input class="form-control" @bind="Product.IsOutstanding" />
            </div>
        }

        @if (ShowDescription == true) {
            <div class="mb-3">
                <label class="form-label">Descripcion</label>
                <input class="form-control" @bind="Product.Description" />
            </div>
        }

        <button class="btn btn-primary" @onclick="SaveChanges">Guardar</button>
    </div>
</div>