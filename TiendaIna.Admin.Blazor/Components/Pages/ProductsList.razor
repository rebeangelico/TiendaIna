@page "/products"
@rendermode InteractiveServer

<h3>Productos</h3>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Precio</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Products?.Any() is true) {
        foreach (var p in Products)
        {
            <tr>
                <td>@p.Name</td>
                <td>@p.Price</td>
                <td>
                    <a class="btn btn-link p-0" title="Editar" href="@($"/products/editnew/{p.Id}")">
                        <i class="bi bi-pencil-fill"></i>
                    </a>

                </td>
            </tr>
        }
        }
    </tbody>
</table>
