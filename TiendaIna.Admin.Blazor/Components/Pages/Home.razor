@page "/"
@using TiendaIna.Core.Entities
@using TiendaIna.Infrastructure.Services

@inject CategoriesRepoDbService CategoryService

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

@if (createdCategory != null) {
    <div class="mt-4 alert alert-success">
        <strong>Categoría creada:</strong><br />
        ID: @createdCategory.Id<br />
        Nombre: @createdCategory.Name<br />
        Padre: @(createdCategory.ParentCategoryId?.ToString() ?? "Ninguno")<br />
    </div>
}

@code {
    private Category? createdCategory;

    protected override void OnInitialized() {
        var id = CategoryService.InsertCategory("Prueba desde Home");
        createdCategory = CategoryService.GetCategoryById(id);
    }
}