@page "/"
@rendermode InteractiveServer
<PageTitle>Home</PageTitle>

@code {
    protected Dictionary<int, string>? Data { get; set; } = new() {
        { 1, "Primero" },
        { 2, "Segundo" },
        { 3, "Tercero" },
    };

    protected HashSet<int>? SelectedValues { get; set; } = [ 1 ];

    public void OnSelectValueChanged(HashSet<int> values) {
        SelectedValues = values;
    }
}

<div class="container container-fluid">
    <CheckboxGroup TValue="int" Data="Data" @bind-SelectedValues="SelectedValues" />
</div>

<div class="container container-fluid">
    <CheckboxGroup TValue="int" Data="Data" SelectedValues="SelectedValues" SelectedValuesChanged="OnSelectValueChanged" />
</div>

<div class="container container-fluid">
    <CheckboxGroup TValue="int" Data="Data" SelectedValues="SelectedValues" SelectedValuesChanged="(values) => OnSelectValueChanged(values)" />
</div>

<ul>
@foreach (var sv in SelectedValues)
{
    <li>@sv</li>
}
</ul>